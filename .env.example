# Select exactly one provider. No provider/model fallback or automatic retries.
# groq -> openai/gpt-oss-120b; gemini -> gemini-2.5-flash-lite
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Public browser testing budget; applied at build time. Not a security boundary.
NEXT_PUBLIC_BLUEPRINT_DAILY_LIMIT=12

# Private process-wide attempted generations per UTC day.
BLUEPRINT_SERVER_DAILY_LIMIT=12
